# ==============================================================================
# CẤU HÌNH MẪU NGINX REVERSE PROXY CHO 7BANK / OCAPAY GATEWAY TRÊN VPS
# ==============================================================================
# Đặt file này tại: /etc/nginx/sites-available/7bank.conf
# Kích hoạt: sudo ln -s /etc/nginx/sites-available/7bank.conf /etc/nginx/sites-enabled/
# Kiểm tra cú pháp: sudo nginx -t
# Tải lại Nginx: sudo systemctl reload nginx
# ==============================================================================

server {
    listen 80;
    listen [::]:80;

    # Thay đổi bằng tên miền của bạn hoặc IP máy chủ VPS
    server_name yourdomain.com api.yourdomain.com 103.xxx.xxx.xxx;

    # Giới hạn dung lượng tải lên (ảnh QR, hóa đơn nạp, file đính kèm)
    client_max_body_size 50M;

    # Ghi log truy cập và lỗi
    access_log /var/log/nginx/7bank_access.log;
    error_log /var/log/nginx/7bank_error.log;

    # Chuyển tiếp toàn bộ request về Node.js Server đang chạy cổng 3000
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Cấu hình WebSocket (cần thiết cho Realtime / LiveChat)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Chuyển tiếp thông tin Host, IP thật của khách hàng
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout cho các tác vụ giao dịch và giải mã
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
        proxy_buffering off;
    }
}

# ==============================================================================
# HƯỚNG DẪN CÀI ĐẶT SSL HTTPS MIỄN PHÍ VỚI CERTBOT:
# sudo apt install certbot python3-certbot-nginx -y
# sudo certbot --nginx -d yourdomain.com -d api.yourdomain.com
# ==============================================================================
