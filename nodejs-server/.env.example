# ==============================================================================
# 7BANK / OCAPAY GATEWAY - CẤU HÌNH MẪU CHO VPS (TEMPLATE)
# Sao chép file này thành .env và điền thông tin tương ứng: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH IP VÀ TÊN MIỀN VPS
# ------------------------------------------------------------------------------
SERVER_IP=103.xxx.xxx.xxx
DOMAIN=api.yourdomain.com
APP_PROTOCOL=https
PORT=3000
HOST=0.0.0.0
APP_URL=https://api.yourdomain.com
TRUST_PROXY=true
CORS_ORIGIN=*
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU MONGODB & BẢO MẬT
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/bank7gate
JWT_SECRET=your_super_secret_jwt_key_here
KEYS_DIR=keys

# ------------------------------------------------------------------------------
# 3. QUẢN TRỊ VIÊN & THÔNG BÁO BẢO MẬT
# ------------------------------------------------------------------------------
ADMIN_EMAIL=your_email@gmail.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. TỰ ĐỘNG QUÉT BIẾN ĐỘNG (BACKGROUND CRON POLLER)
# ------------------------------------------------------------------------------
CRON_ENABLED=true
CRON_INTERVAL="*/1 * * * *"

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH GIẢI CAPTCHA AI NỘI BỘ (100% OFFLINE - KHÔNG CẦN BÊN THỨ 3)
# ------------------------------------------------------------------------------
# Chế độ giải: local_offline (Mô hình AI Deep Learning ddddocr + OpenCV)
# Tự động 100%, miễn phí trọn đời, không phụ thuộc API bên ngoài
CAPTCHA_MODE=local_offline
CAPTCHA_LOCAL_ENGINE_URL=http://127.0.0.1:8088

# ------------------------------------------------------------------------------
# 6. ĐƯỜNG DẪN PYTHON & GOOGLE CHROME TRÊN VPS
# ------------------------------------------------------------------------------
PYTHON_PATH=python3
PYTHON_BRIDGE_PATH=
CHROME_PATH=/usr/bin/google-chrome
